digraph SmartParking {
  rankdir=LR; splines=true; nodesep=0.35; ranksep=1.3; compound=true;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9];

  // ---------- actors ----------
  node [shape=none, image="actor.png", imagescale=false, labelloc=b, fixedsize=true, width=1.9, height=1.6, label=""];
  Driver     [label="Driver"];
  Attendant  [label="Parking Attendant"];
  Admin      [label="Administrator"];
  Payment    [label="Payment Gateway\n«secondary actor»"];
  Camera     [label="ANPR Camera\n«secondary actor»"];

  // ---------- system boundary ----------
  subgraph cluster_sys {
    label="Smart Parking Management System"; labeljust=c; fontsize=15; style=rounded; color="#1e5eff"; penwidth=2;
    node [shape=ellipse, image="", imagescale=false, labelloc=c, fixedsize=false, width=0, height=0, style=filled, fillcolor="#EAF1FF", color="#1e5eff", fontsize=11];

    Search  [label="Search Free\nParking Slots"];
    Reserve [label="Reserve\nParking Slot"];
    Pay     [label="Pay Parking Fee\nOnline"];
    Enter   [label="Enter Car Park"];
    Exit    [label="Exit Car Park"];
    Lost    [label="Handle Lost Ticket", fillcolor="#FFF3D6", color="#C77700"];
    Manual  [label="Enter Plate\nManually", fillcolor="#FFF3D6", color="#C77700"];
    Tariff  [label="Configure Tariff"];
    Report  [label="View Occupancy\nReports"];
    Login   [label="Login", fillcolor="#E6F4EA", color="#2E7D32"];
    Read    [label="Read Number\nPlate", fillcolor="#E6F4EA", color="#2E7D32"];
    Open    [label="Open Barrier", fillcolor="#E6F4EA", color="#2E7D32"];
    Calc    [label="Calculate\nParking Fee", fillcolor="#E6F4EA", color="#2E7D32"];
  }

  // ---------- associations ----------
  edge [dir=none, color="#1b2430"];
  Driver -> Search; Driver -> Reserve; Driver -> Pay; Driver -> Enter; Driver -> Exit;
  Attendant -> Lost; Attendant -> Manual;
  Admin -> Tariff; Admin -> Report;
  Pay -> Payment;
  Read -> Camera;

  // ---------- include (base -> included) ----------
  edge [dir=forward, style=dashed, arrowhead=open, color="#2E7D32", fontcolor="#2E7D32", label="«include»"];
  Reserve -> Login; Pay -> Login; Lost -> Login; Tariff -> Login; Report -> Login;
  Pay -> Calc; Exit -> Calc;
  Enter -> Read; Exit -> Read;
  Enter -> Open; Exit -> Open;

  // ---------- extend (extension -> base) ----------
  edge [color="#C77700", fontcolor="#C77700", label="«extend»"];
  Lost -> Exit;
  Manual -> Read;

  {rank=min; Admin; Attendant; Driver; Payment}
  {rank=max; Camera}
}
